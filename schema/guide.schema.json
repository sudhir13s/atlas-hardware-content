{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/hardware/guide.schema.json",
  "title": "guide",
  "unevaluatedProperties": false,
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "description": "One block of the GPU Buying Guide page. `page_section` says where the page shows it. The title is the heading, the optional body sections Overview and Takeaway are the lead-in and the closing rule, and the lists and table below are rows of strings exactly as the page shows them. A `further-reading` block keeps its links in `sources`.",
  "properties": {
    "type": { "const": "guide" },
    "schema_version": { "const": 3.0 },
    "page_section": {
      "enum": ["quick-decision", "background", "power", "further-reading"],
      "description": "the page section that shows the block; blocks of one section follow `order`"
    },
    "order": { "type": "integer", "minimum": 1, "description": "position of the block in the guide" },
    "decisions": {
      "type": "array",
      "description": "quick-decision rows; `section` is the id of the page section that explains the row",
      "items": { "$ref": "#/$defs/row", "required": ["scenario", "recommendation"] }
    },
    "mistakes": {
      "type": "array",
      "items": { "$ref": "#/$defs/row", "required": ["mistake", "why"] }
    },
    "points": {
      "type": "array",
      "description": "named lines of a topic",
      "items": { "$ref": "#/$defs/row", "required": ["name", "text"] }
    },
    "table": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["page_section", "order"],
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
