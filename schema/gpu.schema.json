{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/hardware/gpu.schema.json",
  "title": "gpu",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "gpu" },
    "vendor": { "type": "string", "enum": ["NVIDIA", "AMD", "Intel", "Apple", "Google"] },
    "segment": { "type": "string", "enum": ["datacenter", "workstation", "consumer"] },
    "series": { "type": "string", "description": "product family, e.g. 'Hopper', 'GeForce RTX 40', 'Instinct'" },
    "generation": { "type": "string", "description": "architecture generation as the vendor names it, e.g. 'Ada Lovelace', 'CDNA 3', 'M4'" },
    "release_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "signal_strength": { "type": "string", "enum": ["high", "medium", "low"], "description": "how much AI-practitioner attention the product draws" },
    "summary": { "type": "string", "minLength": 1, "description": "one-sentence description; the Overview section repeats it" },
    "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "other written names, e.g. 'H100 SXM5'" },
    "specifications": { "$ref": "#/$defs/specifications" },
    "performance": { "$ref": "#/$defs/performance" },
    "ml_capabilities": { "$ref": "#/$defs/ml_capabilities" },
    "framework_support": { "$ref": "#/$defs/framework_support" },
    "market": { "$ref": "#/$defs/market" },
    "best_for": { "$ref": "#/$defs/labels" },
    "key_features": { "$ref": "#/$defs/labels" },
    "limitations": { "$ref": "#/$defs/labels" },
    "notable_users": { "$ref": "#/$defs/labels" },
    "image": { "type": "string", "description": "public path of the product photo, e.g. '/images/gpus/nvidia-h100-sxm.jpg'" }
  },
  "required": ["vendor", "segment", "series", "generation", "release_date", "signal_strength", "specifications", "performance", "ml_capabilities", "framework_support", "market"],
  "$defs": {
    "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "specifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_kind", "memory_gb", "memory_type", "memory_bandwidth_gb_per_s", "compute_units", "compute_unit_type", "tdp_watts", "form_factor", "process_node"],
      "properties": {
        "unit_kind": { "type": "string", "enum": ["gpu", "module"], "description": "'module' = several GPUs sold as one unit; memory, compute units and TDP then cover the whole module" },
        "gpus_per_module": { "type": "integer", "minimum": 2 },
        "memory_gb": { "type": "number", "exclusiveMinimum": 0 },
        "memory_type": { "type": "string" },
        "memory_note": { "type": "string", "description": "remark the source put beside the memory type" },
        "memory_kind": { "type": "string", "enum": ["unified"], "description": "set only when CPU and GPU share the memory" },
        "memory_bandwidth_gb_per_s": { "type": "number", "exclusiveMinimum": 0 },
        "compute_units": { "type": "integer", "minimum": 1 },
        "compute_unit_type": { "type": "string" },
        "compute_unit_note": { "type": "string" },
        "tensor_cores": { "type": "integer", "minimum": 1 },
        "rt_cores": { "type": "integer", "minimum": 1 },
        "tdp_watts": { "type": "number", "exclusiveMinimum": 0 },
        "form_factor": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pcie_gen": { "type": "number" },
        "interconnect": { "$ref": "#/$defs/interconnect" },
        "process_node": { "$ref": "#/$defs/process_node" }
      }
    },
    "interconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bandwidth_gb_per_s": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string", "description": "the bracketed remark as written, when it says more than the bandwidth (per GPU, per link, die-to-die)" }
      }
    },
    "process_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes_nm"],
      "properties": {
        "nodes_nm": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "note": { "type": "string", "description": "the original text, kept when it is composite or carries a foundry or generation remark" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "description": "peak figures as the source gives them; whether they assume sparsity is not stated in the data",
      "properties": {
        "fp32_tflops": { "type": "number", "minimum": 0 },
        "fp16_tflops": { "type": "number", "minimum": 0 },
        "bf16_tflops": { "type": "number", "minimum": 0 },
        "tf32_tflops": { "type": "number", "minimum": 0 },
        "fp8_tflops": { "type": "number", "minimum": 0 },
        "int8_tops": { "type": "number", "minimum": 0 },
        "performance_basis_note": { "type": "string", "description": "what the figures assume (dense or sparse), when a source states it" }
      }
    },
    "ml_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inference", "training", "fine_tuning", "max_model_params_b_inference", "sparsity_support", "transformer_engine"],
      "properties": {
        "inference": { "type": "boolean" },
        "training": { "type": "boolean" },
        "fine_tuning": { "type": "boolean" },
        "max_model_params_b_inference": { "type": "number", "minimum": 0 },
        "max_model_params_b_training": { "type": "number", "minimum": 0 },
        "multi_gpu_scaling": { "$ref": "#/$defs/multi_gpu_scaling" },
        "sparsity_support": { "type": "boolean" },
        "transformer_engine": { "type": "boolean" }
      }
    },
    "multi_gpu_scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technology"],
      "properties": {
        "technology": { "type": "string", "minLength": 1 },
        "max_units": { "type": "integer", "minimum": 2, "description": "most GPUs or chips the technology joins, when the source states a count" },
        "note": { "type": "string" }
      }
    },
    "framework_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pytorch", "tensorflow", "jax", "onnx_runtime", "tensorrt", "directml", "mlx", "rocm", "oneapi", "triton", "vllm", "deepspeed"],
      "properties": {
        "pytorch": { "type": "boolean" },
        "tensorflow": { "type": "boolean" },
        "jax": { "type": "boolean" },
        "onnx_runtime": { "type": "boolean" },
        "tensorrt": { "type": "boolean" },
        "directml": { "type": "boolean" },
        "mlx": { "type": "boolean" },
        "rocm": { "type": "boolean" },
        "oneapi": { "type": "boolean" },
        "triton": { "type": "boolean" },
        "vllm": { "type": "boolean" },
        "deepspeed": { "type": "boolean" }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "description": "agent-owned: prices change; unknown prices are absent",
      "required": ["observed_at", "source"],
      "properties": {
        "msrp_usd": { "type": "number", "minimum": 0 },
        "cloud_hourly_usd": { "type": "number", "minimum": 0 },
        "cloud_providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "instance_note": { "type": "string", "description": "instance family or product as written, e.g. 'p5 instances'" }
            }
          }
        },
        "observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
